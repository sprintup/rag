{
  // MCP servers for this workspace (see 06_readme-mcp-agents.md).
  // "fetch" is the reference Fetch MCP server: one tool, "fetch", that downloads a web page
  // and returns it as Markdown. uvx downloads and runs it in its own isolated environment,
  // so nothing is installed into venv_rag.
  "servers": {
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    }
  }
}
