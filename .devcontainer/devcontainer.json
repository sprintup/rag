// Dev container for running Envie in GitHub Codespaces or locally with the VS Code Dev Containers extension.
// For format details, see https://aka.ms/devcontainer.json
{
	"name": "Envie (local RAG)",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

	// TinyLlama needs ~5 GB of RAM on CPU, plus ~5 GB of disk for libraries and models.
	// A 4-core codespace answers noticeably faster than a 2-core one.
	"hostRequirements": {
		"memory": "8gb",
		"storage": "32gb"
	},

	// Installs the libraries and downloads the models into models/ (see post-create.sh).
	"postCreateCommand": "bash .devcontainer/post-create.sh",

	"containerEnv": {
		// Uploads go through the Codespaces port proxy, which Streamlit's XSRF check rejects (HTTP 403)
		"STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION": "false",
		"STREAMLIT_BROWSER_GATHER_USAGE_STATS": "false"
	},

	"forwardPorts": [8501],
	"portsAttributes": {
		"8501": {
			"label": "Envie (Streamlit)",
			"onAutoForward": "openBrowser"
		}
	},

	"customizations": {
		"vscode": {
			"extensions": ["ms-python.python"]
		},
		"codespaces": {
			"openFiles": ["02_readme-rag-user-guide.md"]
		}
	}
}
