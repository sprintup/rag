// Dev container for running Envie in GitHub Codespaces or locally with the VS Code Dev Containers extension.
// For format details, see https://aka.ms/devcontainer.json
{
	"name": "Envie (local RAG)",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

	// The GitHub CLI, for share-live-qa.sh: it makes the live Q&A's port public for a session
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	// TinyLlama needs ~5 GB of RAM on CPU, plus ~5 GB of disk for libraries and models.
	// The live Q&A's Qwen 3.5 (in Ollama) needs ~4 GB more RAM and ~5 GB more disk.
	// A 4-core codespace (16 GB) answers noticeably faster than a 2-core one.
	"hostRequirements": {
		"memory": "8gb",
		"storage": "32gb"
	},

	// Installs the libraries and downloads the models into models/ (see post-create.sh).
	"postCreateCommand": "bash .devcontainer/post-create.sh",

	"containerEnv": {
		// Uploads go through the Codespaces port proxy, which Streamlit's XSRF check rejects (HTTP 403)
		"STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION": "false",
		"STREAMLIT_BROWSER_GATHER_USAGE_STATS": "false"
	},

	"forwardPorts": [8501],
	"portsAttributes": {
		"8501": {
			"label": "Envie (Streamlit)",
			"onAutoForward": "openBrowser"
		},
		// Ollama's API has no password, so it's never forwarded out of the codespace
		"11434": {
			"label": "Ollama (not forwarded)",
			"onAutoForward": "ignore"
		}
	},
	// Nothing else is forwarded by itself either, e.g. the random port of Ollama's model runner
	// (llama-server), which has no password either
	"otherPortsAttributes": {
		"onAutoForward": "ignore"
	},

	"customizations": {
		"vscode": {
			"extensions": ["ms-python.python"]
		},
		"codespaces": {
			// Opened when a codespace starts: the guide for running the live Q&A
			"openFiles": ["readme-live-qa.md"]
		}
	}
}
